{
  "policy": {
    "name": "f5-observability-lab-waf",
    "description": "Blocking policy for the BIG-IP observability lab",
    "template": {
      "name": "POLICY_TEMPLATE_RAPID_DEPLOYMENT"
    },
    "applicationLanguage": "utf-8",
    "enforcementMode": "blocking",
    "blocking-settings": {
      "violations": [
        {
          "name": "VIOL_ATTACK_SIGNATURE",
          "alarm": true,
          "block": true
        },
        {
          "name": "VIOL_EVASION",
          "alarm": true,
          "block": true
        },
        {
          "name": "VIOL_HTTP_PROTOCOL",
          "alarm": true,
          "block": true
        }
      ]
    }
  }
}